{
	"name": "fjader",
	"description": "An experimental, declarative charting library for Svelte and Python that queries DuckDB and renders with WebGPU",
	"keywords": [
		"visualization",
		"declarative",
		"grammar-of-graphics",
		"webgpu",
		"duckdb",
		"svelte",
		"crossfilter"
	],
	"license": "BSD-3-Clause",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dlyngman/fjader.git"
	},
	"version": "0.2.0",
	"type": "module",
	"svelte": "./dist/index.js",
	"exports": {
		".": {
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./theme.css": "./dist/theme.css"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"package": "svelte-package",
		"prepack": "svelte-package",
		"prepare": "svelte-kit sync || echo ''",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest",
		"typecheck": "svelte-check --tsconfig ./jsconfig.json",
		"build:widget": "vite build --config vite.widget.config.js",
		"build:streamlit": "vite build --config vite.streamlit.config.js",
		"build:streamlit:bundled": "vite build --config vite.streamlit-bundled.config.js && mv python/fjader/streamlit_frontend/index-bundled.html python/fjader/streamlit_frontend/index.html",
		"build:all": "npm run build:widget && npm run build:streamlit",
		"build:python": "npm run build:all && cd python && uv build",
		"fetch-data": "node scripts/fetch-data.js"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.0",
		"@eslint/js": "^10.0.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@types/d3-color": "^3.1.3",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-scale-chromatic": "^3.1.0",
		"@webgpu/types": "^0.1.69",
		"duckdb": "^1.4.4",
		"eslint": "^10.0.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.15.0",
		"globals": "^17.0.0",
		"open-props": "^1.7.23",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"rollup-plugin-license": "^3.7.1",
		"streamlit-component-lib": "^2.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.4.1",
		"temporal-spec": "^1.0.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.1",
		"vite": "^7.0.0",
		"vitest": "^4.0.18"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@duckdb/duckdb-wasm": "1.30.0",
		"@uwdata/flechette": "2.3.0",
		"@uwdata/mosaic-sql": "^0.34.2",
		"d3-array": "^3.2.4",
		"d3-color": "^3.1.0",
		"d3-format": "^3.1.0",
		"d3-scale": "^4.0.2",
		"d3-scale-chromatic": "^3.1.0"
	}
}
