{
	"name": "diveplot",
	"private": true,
	"license": "BSD-3-Clause",
	"version": "0.0.8",
	"type": "module",
	"svelte": "./dist/index.js",
	"exports": {
		".": {
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./theme.css": "./dist/theme.css"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"package": "svelte-package",
		"prepack": "svelte-package",
		"prepare": "svelte-kit sync || echo ''",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest",
		"typecheck": "svelte-check --tsconfig ./jsconfig.json",
		"build:widget": "vite build --config vite.widget.config.js",
		"build:streamlit": "vite build --config vite.streamlit.config.js",
		"build:all": "npm run build:widget && npm run build:streamlit",
		"build:python": "npm run build:all && cd python && uv build"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@types/d3-color": "^3.1.3",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-scale-chromatic": "^3.1.0",
		"@webgpu/types": "^0.1.69",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"open-props": "^1.7.23",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"streamlit-component-lib": "^2.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.4.1",
		"typescript": "^5.9.3",
		"vite": "^6.2.6",
		"vitest": "^4.0.18"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@uwdata/mosaic-core": "^0.21.1",
		"@uwdata/vgplot": "^0.21.1",
		"d3-scale": "^4.0.2"
	}
}
